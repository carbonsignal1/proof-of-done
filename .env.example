# Copy to .env.local and fill in. Leave a section empty to run that part in mock mode.

# --- Claude (checklists + photo verification) ---
ANTHROPIC_API_KEY=

# --- PayPal Sandbox: https://developer.paypal.com/dashboard/applications/sandbox ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Default Sandbox account that receives worker payouts when the worker doesn't enter one.
PAYPAL_PAYOUT_RECEIVER=

# Where jobs and photos are stored (default ./.data)
DATA_DIR=
